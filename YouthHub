    async function toggleStudentCheckIn(studentId) {
      const activeEv = appState.events.find((ev) => ev.id === appState.activeEventId);
      if (!activeEv) return;

      if (!Array.isArray(activeEv.attendees)) activeEv.attendees = [];
      const idx = activeEv.attendees.indexOf(studentId);
      if (idx >= 0) {
        activeEv.attendees.splice(idx, 1);
      } else {
        activeEv.attendees.push(studentId);
      }

      await dbPut('events', activeEv);
      document.getElementById('checkin-count-display').textContent = activeEv.attendees.length;
      renderCheckInList();
      renderDashboard();
    }

