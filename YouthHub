        return;
      }

      const reader = new FileReader();
      reader.onload = (e) => {
        const uploadedAt = new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
        appState.currentPermissionPdf = {
          dataUrl: e.target.result,
          fileName: file.name,
          uploadedAt
        };
        document.getElementById('st-perm-signed').checked = true;
        updatePermissionPdfUI();
        showToast('Permission form PDF attached!', 'success');
      };
      reader.readAsDataURL(file);
    }

