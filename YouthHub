    /**
     * ============================================================================
     * SMART ALERTS ENGINE (Birthdays in Next 14 Days & 2 Missed Midweeks)
     * ============================================================================
     */
    function getUpcomingBirthdays() {
      const today = new Date();
      today.setHours(0, 0, 0, 0);
      const results = [];

      appState.students.forEach((st) => {
        if (!st.dob) return;
        const parts = st.dob.split('-');
        if (parts.length !== 3) return;
        const birthYear = Number(parts[0]);
        const birthMonth = Number(parts[1]) - 1;
        const birthDay = Number(parts[2]);

        let nextBday = new Date(today.getFullYear(), birthMonth, birthDay);
        if (nextBday < today) {
          nextBday = new Date(today.getFullYear() + 1, birthMonth, birthDay);
        }

        const diffDays = Math.round((nextBday - today) / (1000 * 60 * 60 * 24));
        if (diffDays >= 0 && diffDays <= 14) {
          const turningAge = nextBday.getFullYear() - birthYear;
          results.push({
            student: st,
            diffDays,
            turningAge,
            dateLabel: nextBday.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })
          });
        }
      });

      return results.sort((a, b) => a.diffDays - b.diffDays);
    }

    function getMissedTwoMidweekAlerts() {
      const midweekEvents = appState.events
        .filter((ev) => ev.type === 'Midweek Service')
        .sort((a, b) => b.date.localeCompare(a.date));

      if (midweekEvents.length < 2) return [];

      const latest = midweekEvents[0];
      const previous = midweekEvents[1];
      const latestAttendees = new Set(latest.attendees || []);
      const prevAttendees = new Set(previous.attendees || []);

      const alerts = [];
      appState.students.forEach((st) => {
        const dismissKey = `${st.id}_${latest.id}`;
        if (appState.dismissedFollowUps[dismissKey]) return;

        if (!latestAttendees.has(st.id) && !prevAttendees.has(st.id)) {
          const firstName = (st.name || 'Student').split(' ')[0];
          const suggestion = st.canText && st.phone
            ? `Send ${firstName} a quick text: "Hey ${firstName}! Missed seeing you at youth the last couple weeks—hope your week is going great!"`
            : st.parent1Phone
            ? `Check in with ${st.parent1Name || 'parent'} (${st.parent1Phone}) to let them know ${firstName} was missed.`
            : `Assign a small group leader to check in with ${firstName} at school or Sunday morning.`;

          alerts.push({
            student: st,
            dismissKey,
            missedDates: `${formatDisplayDate(previous.date)} & ${formatDisplayDate(latest.date)}`,
            suggestion
          });
        }
      });

      return alerts;
    }

