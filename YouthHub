    async function saveNewEvent(e) {
      if (e && typeof e.preventDefault === 'function') e.preventDefault();
      const name = document.getElementById('event-name-input').value.trim();
      const date = document.getElementById('event-date-input').value;
      const type = document.getElementById('event-type-input').value;

      if (!name || !date) {
        showToast('Please enter an event name and date.', 'error');
        return;
      }

      const newEvent = {
        id: 'ev_' + Date.now(),
        name,
        date,
        type,
        attendees: []
      };

      appState.events.unshift(newEvent);
      appState.events.sort((a, b) => b.date.localeCompare(a.date));
      appState.activeEventId = newEvent.id;

      await dbPut('events', newEvent);
      closeCreateEventModal();
      renderEventSelector();
