    async function deleteCurrentEvent() {
      const activeEv = appState.events.find((ev) => ev.id === appState.activeEventId);
      if (!activeEv) return;

      const confirmed = await showConfirmDialog(
        'Delete Event?',
        `Remove "${activeEv.name}" (${formatDisplayDate(activeEv.date)}) and its attendance log?`,
        'Delete Event',
        true
      );
      if (!confirmed) return;

      await dbDelete('events', activeEv.id);
      appState.events = appState.events.filter((ev) => ev.id !== activeEv.id);
      appState.activeEventId = appState.events.length > 0 ? appState.events[0].id : null;

      renderEventSelector();
      renderCheckInList();
      renderDashboard();
      showToast('Event deleted.', 'info');
