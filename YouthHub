    async function exportBackupJSON() {
      try {
        const payload = {
          app: 'YouthHubCheckIn',
          version: 1,
          exportedAt: new Date().toISOString(),
          leader: leaderProfile,
          students: appState.students,
          events: appState.events,
          dismissedFollowUps: appState.dismissedFollowUps
        };

        const jsonStr = JSON.stringify(payload, null, 2);
        const blob = new Blob([jsonStr], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const dateStamp = new Date().toISOString().split('T')[0];

        const a = document.createElement('a');
        a.href = url;
        a.download = `YouthHub-Backup-${dateStamp}.json`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        setTimeout(() => URL.revokeObjectURL(url), 1000);

        const nowLabel = new Date().toLocaleString();
        if (leaderProfile) {
          leaderProfile.lastBackup = nowLabel;
          await dbPut('meta', leaderProfile);
          document.getElementById('last-backup-label').textContent = `Last backup: ${nowLabel}`;
        }

        showToast('Backup downloaded! Save it to your Google Drive.', 'success');
      } catch (err) {
        console.error('Export backup error:', err);
        showToast('Could not export backup file in this preview.', 'error');
      }
    }

    function handleImportBackup(event) {
      const file = event.target.files && event.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = async (e) => {
        try {
          const parsed = JSON.parse(e.target.result);
          if (!parsed || !Array.isArray(parsed.students) || !Array.isArray(parsed.events)) {
            showToast('Invalid YouthHub backup file.', 'error');
            return;
          }

          const confirmed = await showConfirmDialog(
            'Restore Backup?',
            `Replace current roster with ${parsed.students.length} students and ${parsed.events.length} events from this backup?`,
            'Restore Data',
            false
          );
          if (!confirmed) return;

          await dbClear('students');
          await dbClear('events');

          for (const st of parsed.students) {
            await dbPut('students', st);
          }
          for (const ev of parsed.events) {
            await dbPut('events', ev);
          }

          appState.students = parsed.students;
          appState.events = parsed.events.sort((a, b) => b.date.localeCompare(a.date));
          appState.activeEventId = appState.events.length > 0 ? appState.events[0].id : null;
          appState.dismissedFollowUps = parsed.dismissedFollowUps || {};
          await dbPut('meta', { id: 'dismissedFollowUps', map: appState.dismissedFollowUps });

          renderAllViews();
          showToast('Backup restored successfully!', 'success');
        } catch (err) {
          console.error('Import backup error:', err);
          showToast('Could not read backup JSON file.', 'error');
        }
      };
      reader.readAsText(file);
      event.target.value = '';
    }

