  <script>
    /**
     * ============================================================================
     * RESILIENT STORAGE ENGINE (IndexedDB -> localStorage -> In-Memory Fallback)
     * Never hangs or blocks startup in sandboxed iframes, Safari, or strict modes.
     * ============================================================================
     */
    const DB_NAME = 'YouthHubMinistryDB';
    const DB_VERSION = 1;
    const STORES = ['meta', 'students', 'events'];
    let dbInstance = null;
    let storageDriver = 'memory'; // 'indexeddb' | 'localstorage' | 'memory'
    const memoryFallbackStore = { meta: {}, students: {}, events: {} };

    function isLocalStorageAvailable() {
      try {
        const testKey = '__yh_storage_test__';
        window.localStorage.setItem(testKey, '1');
        window.localStorage.removeItem(testKey);
        return true;
      } catch (e) {
        return false;
      }
    }

    function lsReadStore(storeName) {
      try {
        const raw = window.localStorage.getItem(`${DB_NAME}_${storeName}`);
        return raw ? JSON.parse(raw) : {};
      } catch (e) {
        return memoryFallbackStore[storeName] || {};
      }
    }

    function lsWriteStore(storeName, mapObj) {
      memoryFallbackStore[storeName] = mapObj;
      try {
        window.localStorage.setItem(`${DB_NAME}_${storeName}`, JSON.stringify(mapObj));
      } catch (e) {
        // Quota exceeded or restricted; keep in memoryFallbackStore
      }
    }

    function initDB() {
      return new Promise((resolve) => {
        // 1. Check if IndexedDB exists at all
        if (typeof window === 'undefined' || !('indexedDB' in window) || !window.indexedDB) {
          storageDriver = isLocalStorageAvailable() ? 'localstorage' : 'memory';
          return resolve(null);
        }

        let settled = false;
        const finishWithFallback = () => {
          if (settled) return;
          settled = true;
          storageDriver = isLocalStorageAvailable() ? 'localstorage' : 'memory';
          resolve(null);
        };

        // 2. Strict 1200ms timeout so sandboxed previews / Safari never hang on indexedDB.open
        const timeoutId = setTimeout(finishWithFallback, 1200);

        try {
          const req = window.indexedDB.open(DB_NAME, DB_VERSION);

          req.onupgradeneeded = (e) => {
            try {
              const db = e.target.result;
              STORES.forEach((store) => {
                if (!db.objectStoreNames.contains(store)) {
                  db.createObjectStore(store, { keyPath: 'id' });
                }
              });
            } catch (err) {
              // Ignore upgrade errors; onerror or timeout will trigger fallback
            }
          };

          req.onsuccess = (e) => {
            if (settled) return;
            settled = true;
            clearTimeout(timeoutId);
            dbInstance = e.target.result;
            storageDriver = 'indexeddb';
            resolve(dbInstance);
          };

          req.onerror = () => {
            clearTimeout(timeoutId);
            finishWithFallback();
          };

          req.onblocked = () => {
            clearTimeout(timeoutId);
            finishWithFallback();
          };
        } catch (err) {
          clearTimeout(timeoutId);
          finishWithFallback();
        }
      });
    }

    function dbGetAll(storeName) {
      return new Promise((resolve) => {
        if (storageDriver === 'indexeddb' && dbInstance) {
          try {
            const tx = dbInstance.transaction(storeName, 'readonly');
            const req = tx.objectStore(storeName).getAll();
            req.onsuccess = () => resolve(req.result || []);
            req.onerror = () => resolve(Object.values(lsReadStore(storeName)));
            return;
          } catch (e) {
            // Fall through to localStorage/memory
          }
        }
        if (storageDriver === 'localstorage') {
          resolve(Object.values(lsReadStore(storeName)));
        } else {
          resolve(Object.values(memoryFallbackStore[storeName] || {}));
        }
      });
    }

    function dbGet(storeName, id) {
      return new Promise((resolve) => {
        if (storageDriver === 'indexeddb' && dbInstance) {
          try {
            const tx = dbInstance.transaction(storeName, 'readonly');
            const req = tx.objectStore(storeName).get(id);
            req.onsuccess = () => resolve(req.result || null);
            req.onerror = () => resolve((lsReadStore(storeName))[id] || null);
            return;
          } catch (e) {
            // Fall through
          }
        }
        if (storageDriver === 'localstorage') {
          resolve((lsReadStore(storeName))[id] || null);
        } else {
          resolve((memoryFallbackStore[storeName] || {})[id] || null);
        }
      });
    }

    function dbPut(storeName, item) {
      return new Promise((resolve) => {
        // Always mirror in memoryFallbackStore for instant reliability
        if (!memoryFallbackStore[storeName]) memoryFallbackStore[storeName] = {};
        memoryFallbackStore[storeName][item.id] = item;

        if (storageDriver === 'indexeddb' && dbInstance) {
          try {
            const tx = dbInstance.transaction(storeName, 'readwrite');
            const req = tx.objectStore(storeName).put(item);
            req.onsuccess = () => resolve(item);
            req.onerror = () => {
              const map = lsReadStore(storeName);
              map[item.id] = item;
              lsWriteStore(storeName, map);
              resolve(item);
            };
            return;
          } catch (e) {
            // Fall through
          }
        }
        if (storageDriver === 'localstorage') {
          const map = lsReadStore(storeName);
          map[item.id] = item;
          lsWriteStore(storeName, map);
        }
        resolve(item);
      });
    }

    function dbDelete(storeName, id) {
      return new Promise((resolve) => {
        if (memoryFallbackStore[storeName]) {
          delete memoryFallbackStore[storeName][id];
        }

        if (storageDriver === 'indexeddb' && dbInstance) {
          try {
            const tx = dbInstance.transaction(storeName, 'readwrite');
            const req = tx.objectStore(storeName).delete(id);
            req.onsuccess = () => resolve();
            req.onerror = () => {
              const map = lsReadStore(storeName);
              delete map[id];
              lsWriteStore(storeName, map);
              resolve();
            };
            return;
          } catch (e) {
            // Fall through
          }
        }
        if (storageDriver === 'localstorage') {
          const map = lsReadStore(storeName);
          delete map[id];
          lsWriteStore(storeName, map);
        }
        resolve();
      });
    }

    function dbClear(storeName) {
      return new Promise((resolve) => {
        memoryFallbackStore[storeName] = {};

        if (storageDriver === 'indexeddb' && dbInstance) {
          try {
            const tx = dbInstance.transaction(storeName, 'readwrite');
            const req = tx.objectStore(storeName).clear();
            req.onsuccess = () => resolve();
            req.onerror = () => {
              lsWriteStore(storeName, {});
              resolve();
            };
            return;
          } catch (e) {
            // Fall through
          }
        }
        if (storageDriver === 'localstorage') {
          lsWriteStore(storeName, {});
        }
        resolve();
      });
    }

