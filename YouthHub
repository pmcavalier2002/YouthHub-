      await dbPut('meta', leaderProfile);
      document.getElementById('settings-new-pin').value = '';
      document.getElementById('header-ministry-name').textContent = leaderProfile.ministry;
      document.getElementById('header-leader-name').textContent = `Leader: ${leaderProfile.name}`;
      showToast('Leader settings saved!', 'success');
    }

