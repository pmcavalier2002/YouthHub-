    async function saveStudentProfile(e) {
      if (e && typeof e.preventDefault === 'function') e.preventDefault();

      const existingId = document.getElementById('student-id-field').value;
      const autoCheckIn = document.getElementById('student-auto-checkin-field').value === 'true';
      const name = document.getElementById('st-name').value.trim();
      const dob = document.getElementById('st-dob').value;

      if (!name) {
        switchStudentFormTab('basic');
        showToast('Please enter the student’s full name.', 'error');
        return;
      }
      if (!dob) {
        switchStudentFormTab('basic');
        showToast('Please enter the student’s date of birth.', 'error');
        return;
      }

      const studentRecord = {
        id: existingId || 'st_' + Date.now(),
        name,
        gender: document.getElementById('st-gender').value,
        grade: document.getElementById('st-grade').value,
        dob,
        school: document.getElementById('st-school').value.trim(),
        phone: document.getElementById('st-phone').value.trim(),
        canText: document.getElementById('st-can-text').checked,
        address: document.getElementById('st-address').value.trim(),
        photo: appState.currentPhotoDataUrl || '',

        parent1Name: document.getElementById('st-parent1-name').value.trim(),
        parent1Phone: document.getElementById('st-parent1-phone').value.trim(),
        parent2Name: document.getElementById('st-parent2-name').value.trim(),
        parent2Contact: document.getElementById('st-parent2-contact').value.trim(),
        emergency: document.getElementById('st-emergency').value.trim(),
        medical: document.getElementById('st-medical').value.trim(),
        insurance: document.getElementById('st-insurance').value.trim(),
        permSigned: document.getElementById('st-perm-signed').checked,
        photoRelease: document.getElementById('st-photo-release').checked,
        permissionPdf: appState.currentPermissionPdf ? { ...appState.currentPermissionPdf } : null,
        notes: document.getElementById('st-notes').value.trim()
      };

      await dbPut('students', studentRecord);

      if (existingId) {
        const idx = appState.students.findIndex((s) => s.id === existingId);
        if (idx >= 0) appState.students[idx] = studentRecord;
      } else {
        appState.students.push(studentRecord);
      }

      if (autoCheckIn && appState.activeEventId) {
        const activeEv = appState.events.find((ev) => ev.id === appState.activeEventId);
        if (activeEv) {
          if (!Array.isArray(activeEv.attendees)) activeEv.attendees = [];
          if (!activeEv.attendees.includes(studentRecord.id)) {
            activeEv.attendees.push(studentRecord.id);
            await dbPut('events', activeEv);
          }
        }
      }

      closeStudentModal();
      renderAllViews();
      showToast(existingId ? 'Student profile updated!' : `${name} added to roster!`, 'success');
    }

    async function deleteCurrentStudent() {
      const existingId = document.getElementById('student-id-field').value;
      if (!existingId) return;

      const st = appState.students.find((s) => s.id === existingId);
      const confirmed = await showConfirmDialog(
        'Delete Student?',
        `Permanently delete ${st ? st.name : 'this student'} and their forms from this device?`,
        'Delete Student',
        true
      );
      if (!confirmed) return;

      await dbDelete('students', existingId);
      appState.students = appState.students.filter((s) => s.id !== existingId);

      closeStudentModal();
      renderAllViews();
      showToast('Student removed from roster.', 'info');
    }

