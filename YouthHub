<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <meta name="theme-color" content="#4f46e5" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <title>YouthHub Check-In & Roster</title>

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts: Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <!-- Font Awesome for clean mobile icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'system-ui', 'sans-serif'],
          },
        },
      },
    };
  </script>

  <style>
    body {
      font-family: 'Inter', system-ui, sans-serif;
      -webkit-tap-highlight-color: transparent;
      overscroll-behavior-y: none;
    }
    /* Hide scrollbars cleanly where horizontal chips scroll */
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
    @keyframes popIn {
      0% { transform: scale(0.95); opacity: 0; }
      100% { transform: scale(1); opacity: 1; }
    }
    .animate-pop {
      animation: popIn 0.18s ease-out forwards;
    }
  </style>
</head>
<body class="bg-slate-50 text-slate-900 min-h-screen flex flex-col select-none">

  <!-- ==================== TOAST / MESSAGE BANNER ==================== -->
  <div id="toast-container" class="fixed top-4 left-1/2 -translate-x-1/2 z-[100] w-[92%] max-w-md pointer-events-none flex flex-col gap-2"></div>

  <!-- ==================== 1. LEADER SETUP / LOCK SCREEN ==================== -->
  <div id="auth-screen" class="fixed inset-0 z-50 bg-gradient-to-br from-indigo-700 via-indigo-800 to-slate-900 flex items-center justify-center p-4 overflow-y-auto">
    <div class="bg-white rounded-3xl shadow-2xl w-full max-w-md p-6 sm:p-8 animate-pop">
      <div class="flex flex-col items-center text-center mb-6">
        <div class="w-16 h-16 rounded-2xl bg-indigo-600 text-white flex items-center justify-center text-2xl shadow-lg shadow-indigo-200 mb-3">
          <i class="fa-solid fa-fire-flame-curved"></i>
        </div>
        <h1 id="auth-title" class="text-2xl font-extrabold text-slate-900 tracking-tight">YouthHub Check-In</h1>
        <p id="auth-subtitle" class="text-sm text-slate-500 mt-1">Local-first Youth Ministry Roster & Attendance</p>
      </div>

      <!-- First-Time Setup Form -->
      <form id="setup-form" onsubmit="handleSetupSubmit(event)" class="space-y-4 hidden" novalidate>
        <div class="bg-indigo-50 border border-indigo-100 rounded-2xl p-3.5 text-xs text-indigo-800 leading-relaxed">
          <i class="fa-solid fa-shield-halved mr-1"></i>
          <strong>100% Private & Offline:</strong> Your leader account and student database are stored locally on this device. You can export backups to Google Drive anytime.
        </div>
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1">Leader Name *</label>
          <input type="text" id="setup-leader-name" placeholder="e.g., Pastor Mike" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 outline-none text-base" />
        </div>
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1">Ministry / Youth Group Name *</label>
          <input type="text" id="setup-ministry-name" placeholder="e.g., Ignite Student Ministry" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 outline-none text-base" />
        </div>
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1">Create Leader PIN or Password *</label>
          <input type="password" id="setup-pin" placeholder="At least 4 digits or characters" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 outline-none text-base tracking-widest" />
        </div>
        <p id="setup-error" class="text-xs text-rose-600 font-semibold text-center hidden"></p>
        <button type="button" onclick="handleSetupSubmit(event)" class="w-full py-3.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 active:scale-[0.99] text-white font-bold text-base shadow-lg shadow-indigo-200 transition">
          Create Local Leader Account
        </button>
        <div class="pt-1 border-t border-slate-100 text-center">
          <button type="button" onclick="quickDemoSetup()" class="w-full py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs transition flex items-center justify-center gap-1.5">
            <i class="fa-solid fa-wand-magic-sparkles text-indigo-600"></i> Quick Demo / Skip Setup (Loads Sample Group)
          </button>
        </div>
      </form>

      <!-- Sign-In / Unlock Form -->
      <form id="login-form" onsubmit="handleLoginSubmit(event)" class="space-y-4 hidden" novalidate>
        <div class="bg-slate-50 border border-slate-200 rounded-2xl p-4 text-center">
          <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Welcome Back</p>
          <p id="login-leader-display" class="text-lg font-bold text-slate-800 mt-0.5">Leader</p>
          <p id="login-ministry-display" class="text-xs text-indigo-600 font-medium">Youth Ministry</p>
        </div>
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1">Enter Leader PIN / Password</label>
          <input type="password" id="login-pin-input" placeholder="••••" class="w-full px-4 py-3.5 rounded-xl border border-slate-300 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 outline-none text-center text-xl font-bold tracking-widest" />
        </div>
        <p id="login-error" class="text-xs text-rose-600 font-semibold text-center hidden">Incorrect PIN or password. Please try again.</p>
        <button type="button" onclick="handleLoginSubmit(event)" class="w-full py-3.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 active:scale-[0.99] text-white font-bold text-base shadow-lg shadow-indigo-200 transition">
          <i class="fa-solid fa-lock-open mr-2"></i>Unlock Ministry App
        </button>
      </form>
    </div>
  </div>

  <!-- ==================== MAIN APP SHELL ==================== -->
  <div id="app-shell" class="hidden flex-1 flex flex-col max-w-4xl w-full mx-auto pb-24">

    <!-- Top App Header -->
    <header class="sticky top-0 z-30 bg-white/95 backdrop-blur border-b border-slate-200 px-4 py-3 flex items-center justify-between">
      <div class="flex items-center gap-3 min-w-0">
        <div class="w-10 h-10 rounded-xl bg-indigo-600 text-white flex items-center justify-center shrink-0 shadow-sm">
          <i class="fa-solid fa-fire-flame-curved"></i>
        </div>
        <div class="min-w-0">
          <h1 id="header-ministry-name" class="font-extrabold text-slate-900 text-base sm:text-lg truncate leading-tight">Youth Ministry</h1>
          <p id="header-leader-name" class="text-xs text-slate-500 truncate">Leader</p>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <button id="btn-push-perm" onclick="requestBrowserNotifications()" title="Enable Push Notifications" class="px-3 py-2 rounded-xl bg-amber-50 text-amber-700 border border-amber-200 text-xs font-bold flex items-center gap-1.5 hover:bg-amber-100 transition">
          <i class="fa-solid fa-bell"></i>
          <span class="hidden sm:inline">Alerts</span>
        </button>
        <button onclick="lockApp()" title="Lock Screen" class="px-3 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold flex items-center gap-1.5 transition">
          <i class="fa-solid fa-lock"></i>
          <span>Lock</span>
        </button>
      </div>
    </header>

    <!-- ==================== TAB 1: DASHBOARD & SMART ALERTS ==================== -->
    <main id="view-dashboard" class="p-4 space-y-5 animate-pop">
      <!-- Quick Metrics Row -->
      <div class="grid grid-cols-3 gap-3">
        <div class="bg-white p-3.5 rounded-2xl border border-slate-200/80 shadow-sm">
          <p class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Students</p>
          <p id="stat-total-students" class="text-2xl font-extrabold text-slate-900 mt-1">0</p>
        </div>
        <div class="bg-white p-3.5 rounded-2xl border border-slate-200/80 shadow-sm">
          <p class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Events</p>
          <p id="stat-total-events" class="text-2xl font-extrabold text-indigo-600 mt-1">0</p>
        </div>
        <div class="bg-white p-3.5 rounded-2xl border border-slate-200/80 shadow-sm">
          <p class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Alerts</p>
          <p id="stat-total-alerts" class="text-2xl font-extrabold text-amber-600 mt-1">0</p>
        </div>
      </div>

      <!-- Quick Action CTA -->
      <div class="bg-gradient-to-r from-indigo-600 to-violet-600 rounded-2xl p-4 text-white shadow-md flex items-center justify-between gap-3">
        <div>
          <h2 class="font-bold text-base">Ready for Service?</h2>
          <p class="text-xs text-indigo-100 mt-0.5">Start an event or check in arriving students.</p>
        </div>
        <button onclick="switchTab('checkin')" class="px-4 py-2.5 rounded-xl bg-white text-indigo-700 font-bold text-sm shadow hover:bg-indigo-50 shrink-0 transition">
          Open Check-In <i class="fa-solid fa-arrow-right ml-1"></i>
        </button>
      </div>

      <!-- SMART ALERTS SECTION: UPCOMING BIRTHDAYS (NEXT 14 DAYS) -->
      <section class="space-y-2.5">
        <div class="flex items-center justify-between">
          <h3 class="text-sm font-extrabold uppercase tracking-wider text-slate-700 flex items-center gap-2">
            <span class="w-6 h-6 rounded-lg bg-pink-100 text-pink-600 flex items-center justify-center text-xs"><i class="fa-solid fa-cake-candles"></i></span>
            Birthdays (Next 14 Days)
          </h3>
          <span id="badge-birthdays" class="text-xs font-bold px-2.5 py-0.5 rounded-full bg-pink-100 text-pink-700">0</span>
        </div>
        <div id="birthday-alerts-list" class="space-y-2.5">
          <!-- Populated dynamically -->
        </div>
      </section>

      <!-- SMART ALERTS SECTION: MISSED 2 CONSECUTIVE MIDWEEK SERVICES -->
      <section class="space-y-2.5">
        <div class="flex items-center justify-between">
          <h3 class="text-sm font-extrabold uppercase tracking-wider text-slate-700 flex items-center gap-2">
            <span class="w-6 h-6 rounded-lg bg-amber-100 text-amber-600 flex items-center justify-center text-xs"><i class="fa-solid fa-user-clock"></i></span>
            Missed 2 Midweek Services
          </h3>
          <span id="badge-missed" class="text-xs font-bold px-2.5 py-0.5 rounded-full bg-amber-100 text-amber-700">0</span>
        </div>
        <div id="missed-alerts-list" class="space-y-2.5">
          <!-- Populated dynamically -->
        </div>
      </section>
    </main>

    <!-- ==================== TAB 2: EVENTS & FAST CHECK-IN ==================== -->
    <main id="view-checkin" class="hidden p-4 space-y-4 animate-pop">
      <!-- Event Selector & Create Event Bar -->
      <div class="bg-white rounded-2xl border border-slate-200 p-4 shadow-sm space-y-3">
        <div class="flex items-center justify-between gap-2">
          <h2 class="font-extrabold text-slate-900 text-base">Service / Event Check-In</h2>
          <button onclick="openCreateEventModal()" class="px-3 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold flex items-center gap-1.5 shadow-sm transition">
            <i class="fa-solid fa-plus"></i> New Event
          </button>
        </div>

        <div id="event-selector-wrapper">
          <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-1">Active Event</label>
          <div class="flex gap-2">
            <select id="active-event-select" onchange="handleEventChange()" class="flex-1 px-3.5 py-2.5 rounded-xl border border-slate-300 bg-slate-50 font-semibold text-sm text-slate-800 outline-none focus:border-indigo-500">
              <!-- Populated dynamically -->
            </select>
            <button id="btn-delete-event" onclick="deleteCurrentEvent()" title="Delete Selected Event" class="px-3 py-2.5 rounded-xl border border-rose-200 text-rose-600 hover:bg-rose-50 text-sm transition hidden">
              <i class="fa-solid fa-trash-can"></i>
            </button>
          </div>
        </div>

        <!-- Live Event Attendance Counter Banner -->
        <div id="event-live-stats" class="hidden bg-emerald-50 border border-emerald-200 rounded-xl p-3 flex items-center justify-between">
          <div>
            <p id="active-event-meta" class="text-xs font-semibold text-emerald-800">Midweek Service • Date</p>
            <p class="text-[11px] text-emerald-600 mt-0.5">Tap any student card below to toggle check-in</p>
          </div>
          <div class="text-right">
            <span id="checkin-count-display" class="text-2xl font-extrabold text-emerald-700">0</span>
            <span class="block text-[10px] font-bold uppercase tracking-wider text-emerald-600">Checked In</span>
          </div>
        </div>
      </div>

      <!-- Check-In Search, Grade Filter & Quick Add Guest -->
      <div id="checkin-controls" class="space-y-2.5 hidden">
        <div class="flex gap-2">
          <div class="relative flex-1">
            <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
            <input type="text" id="checkin-search" oninput="renderCheckInList()" placeholder="Search student name..." class="w-full pl-9 pr-4 py-2.5 rounded-xl border border-slate-200 bg-white text-sm outline-none focus:border-indigo-500" />
          </div>
          <button onclick="openStudentModal(null, true)" class="px-3.5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold shrink-0 flex items-center gap-1.5 shadow-sm transition">
            <i class="fa-solid fa-user-plus"></i> First-Time Guest
          </button>
        </div>

        <!-- Grade Filter Pills -->
        <div class="flex gap-1.5 overflow-x-auto no-scrollbar pb-1" id="checkin-grade-filters">
          <!-- Populated dynamically -->
        </div>
      </div>

      <!-- Student Tap-to-Check-In Grid -->
      <div id="checkin-student-list" class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
        <!-- Populated dynamically -->
      </div>
    </main>

    <!-- ==================== TAB 3: STUDENT DIRECTORY & PROFILES ==================== -->
    <main id="view-students" class="hidden p-4 space-y-4 animate-pop">
      <div class="flex items-center justify-between gap-2">
        <div>
          <h2 class="font-extrabold text-slate-900 text-lg">Student Roster</h2>
          <p class="text-xs text-slate-500">Tap a student to view or add parent, medical & permission info</p>
        </div>
        <button onclick="openStudentModal(null, false)" class="px-4 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold flex items-center gap-1.5 shadow-sm transition">
          <i class="fa-solid fa-plus"></i> Add Student
        </button>
      </div>

      <!-- Search & Grade Filter -->
      <div class="space-y-2">
        <div class="relative">
          <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
          <input type="text" id="roster-search" oninput="renderRosterList()" placeholder="Search by name, school, or phone..." class="w-full pl-9 pr-4 py-2.5 rounded-xl border border-slate-200 bg-white text-sm outline-none focus:border-indigo-500" />
        </div>
        <div class="flex gap-1.5 overflow-x-auto no-scrollbar pb-1" id="roster-grade-filters">
          <!-- Populated dynamically -->
        </div>
      </div>

      <!-- Student Roster List -->
      <div id="roster-list" class="space-y-2.5">
        <!-- Populated dynamically -->
      </div>
    </main>

    <!-- ==================== TAB 4: BACKUP, GOOGLE DRIVE & SETTINGS ==================== -->
    <main id="view-settings" class="hidden p-4 space-y-4 animate-pop">
      <!-- Google Drive Local Backup & Restore Card -->
      <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm space-y-4">
        <div class="flex items-start justify-between gap-3">
          <div class="flex items-start gap-3">
            <div class="w-11 h-11 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center text-xl shrink-0">
              <i class="fa-brands fa-google-drive"></i>
            </div>
            <div>
              <h2 class="font-extrabold text-slate-900 text-base">Google Drive Backup & Restore</h2>
              <p class="text-xs text-slate-500 mt-0.5 leading-relaxed">
                All student photos, attendance, and permission notes live locally on your device. Export a backup file to save directly to your <strong>Google Drive</strong> folder.
              </p>
            </div>
          </div>
          <span id="storage-mode-badge" class="shrink-0 text-[10px] font-bold px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200">
            <i class="fa-solid fa-database mr-1"></i>IndexedDB
          </span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">
          <button onclick="exportBackupJSON()" class="w-full py-3.5 px-4 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-sm flex items-center justify-center gap-2 shadow-sm transition">
            <i class="fa-solid fa-cloud-arrow-up"></i> Export Backup (.json)
          </button>

          <label class="w-full py-3.5 px-4 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold text-sm flex items-center justify-center gap-2 cursor-pointer transition">
            <i class="fa-solid fa-cloud-arrow-down"></i> Restore Backup (.json)
            <input type="file" id="import-backup-input" accept=".json,application/json" onchange="handleImportBackup(event)" class="hidden" />
          </label>
        </div>
        <p id="last-backup-label" class="text-[11px] text-slate-400 text-center">Last backup: Never</p>
      </div>

      <!-- Share / Export Standalone App File Card -->
      <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm space-y-3">
        <div class="flex items-start gap-3">
          <div class="w-11 h-11 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl shrink-0">
            <i class="fa-solid fa-share-nodes"></i>
          </div>
          <div>
            <h3 class="font-extrabold text-slate-900 text-base">Share or Host This App</h3>
            <p class="text-xs text-slate-500 mt-0.5 leading-relaxed">
              Download the complete, self-contained app file (<strong>YouthHub-App.html</strong>). You can email it to other youth leaders, upload it to Google Drive, or drop it onto a free host like <strong>Netlify Drop</strong> or <strong>GitHub Pages</strong> so anyone can open it on their phone.
            </p>
          </div>
        </div>
        <button type="button" onclick="downloadStandaloneAppHTML()" class="w-full py-3.5 px-4 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm flex items-center justify-center gap-2 shadow-sm transition">
          <i class="fa-solid fa-file-arrow-down"></i> Download Standalone App (.html)
        </button>
      </div>

      <!-- Sample Data & Quick Demo Helper -->
      <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm space-y-3">
        <h3 class="font-extrabold text-slate-900 text-sm">Testing & Demo Tools</h3>
        <p class="text-xs text-slate-500">Want to see how upcoming birthday alerts and 2-week missed midweek service alerts work right away? Load sample students and past services.</p>
        <button onclick="loadSampleData()" class="w-full py-3 px-4 rounded-xl border border-indigo-200 bg-indigo-50/70 hover:bg-indigo-100 text-indigo-700 font-bold text-xs flex items-center justify-center gap-2 transition">
          <i class="fa-solid fa-wand-magic-sparkles"></i> Load Sample Youth Group Data
        </button>
      </div>

      <!-- Leader Account Settings -->
      <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm space-y-3">
        <h3 class="font-extrabold text-slate-900 text-sm">Leader Account & Security</h3>
        <form onsubmit="updateLeaderSettings(event)" class="space-y-3">
          <div>
            <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-1">Leader Name</label>
            <input type="text" id="settings-leader-name" required class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-sm outline-none focus:border-indigo-500" />
          </div>
          <div>
            <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-1">Ministry Name</label>
            <input type="text" id="settings-ministry-name" required class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-sm outline-none focus:border-indigo-500" />
          </div>
          <div>
            <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-1">New PIN / Password (leave blank to keep current)</label>
            <input type="password" id="settings-new-pin" minlength="4" placeholder="••••" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-sm outline-none focus:border-indigo-500" />
          </div>
          <button type="submit" class="w-full py-3 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs transition">
            Save Leader Settings
          </button>
        </form>
      </div>

      <!-- Android Install Tip -->
      <div class="bg-slate-100 rounded-2xl p-4 text-xs text-slate-600 space-y-1.5">
        <p class="font-bold text-slate-800"><i class="fa-brands fa-android text-emerald-600 mr-1"></i> Install on Android Home Screen</p>
        <p>Open this app in <strong>Chrome on Android</strong>, tap the <strong>⋮ menu</strong> in the top right, and select <strong>"Add to Home screen"</strong> or <strong>"Install app"</strong> for a full-screen offline experience.</p>
      </div>
    </main>
  </div>

  <!-- ==================== BOTTOM NAVIGATION BAR ==================== -->
  <nav id="bottom-nav" class="hidden fixed bottom-0 inset-x-0 z-30 bg-white border-t border-slate-200 px-2 py-1.5 shadow-[0_-4px_12px_rgba(0,0,0,0.04)]">
    <div class="max-w-4xl mx-auto grid grid-cols-4 gap-1">
      <button onclick="switchTab('dashboard')" id="nav-dashboard" class="nav-btn flex flex-col items-center justify-center py-1.5 rounded-xl text-indigo-600 font-bold relative">
        <span id="nav-alert-dot" class="hidden absolute top-1.5 right-1/4 w-2.5 h-2.5 rounded-full bg-rose-500 ring-2 ring-white"></span>
        <i class="fa-solid fa-house text-lg"></i>
        <span class="text-[11px] mt-0.5">Home</span>
      </button>
      <button onclick="switchTab('checkin')" id="nav-checkin" class="nav-btn flex flex-col items-center justify-center py-1.5 rounded-xl text-slate-400 font-medium">
        <i class="fa-solid fa-clipboard-check text-lg"></i>
        <span class="text-[11px] mt-0.5">Check-In</span>
      </button>
